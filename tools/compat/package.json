{
  "name": "inkcalidraw-compat-check",
  "private": true,
  "type": "module",
  "description": "Checks files written by the Android app against the real Excalidraw package in headless Chromium",
  "scripts": {
    "bundle": "esbuild verify.entry.js --bundle --format=iife --outfile=verify.bundle.js --loader:.css=empty --loader:.woff2=empty --define:process.env.NODE_ENV='\"production\"' --define:import.meta.env='{\"DEV\":false,\"PROD\":true,\"MODE\":\"production\"}' --log-level=error",
    "check": "npm run bundle && node run.mjs ../../fixtures ../../fixtures/rendered-by-excalidraw.png"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "fractional-indexing": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": { "esbuild": "^0.25.0", "playwright": "1.56.1" }
}
